# Copy to .env and edit. Defaults are safe: auth on, local models, no external calls.
# See MANUAL_STEPS.md for what you must configure by hand.

# --- Storage ---
DB_PATH=data/db/rag.sqlite3

# --- Authentication ---
# Groups are resolved SERVER-SIDE from the API key and are never accepted from
# the request body. Never set AUTH_ENABLED=false outside local development.
AUTH_ENABLED=true
API_KEYS_PATH=keys.json
DEV_BYPASS_GROUPS=public

# --- Embeddings (local, free, default) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Reranker (local, free, default) ---
# NOTE: this is ~90% of query latency (see DEPLOYMENT.md §2). If you need
# faster queries, this is the stage to attack — not vector search.
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_ENABLED=true

# --- Ingestion ---
# Bump PIPELINE_VERSION whenever parsing/chunking/embedding logic changes.
# It is mixed into each document's content hash, so a change forces re-indexing
# instead of silently keeping chunks built by the old logic.
PIPELINE_VERSION=v2
EMBED_BATCH_SIZE=64
MAX_UPLOAD_MB=50

# --- Chunking ---
CHUNK_TARGET_TOKENS=450
CHUNK_OVERLAP_TOKENS=60

# --- Retrieval ---
RETRIEVAL_TOP_K_VECTOR=20
RETRIEVAL_TOP_K_KEYWORD=20
# Lowering this is the cheapest way to cut reranker latency (cost is linear in
# candidate count).
RETRIEVAL_TOP_K_FUSED=8
RETRIEVAL_MIN_SCORE=0.15

# Relevance floors deciding "answer" vs "not in corpus".
# ABSOLUTE_RELEVANCE_FLOOR is CALIBRATED, not guessed — run
# eval/calibrate_threshold.py after ANY change to corpus, embedding model,
# reranker, or chunking. The separating margin on the sample corpus is only
# 0.43 points, so this will NOT transfer to your data unchanged.
RELEVANCE_SCORE_GAP=6.0
ABSOLUTE_RELEVANCE_FLOOR=-2.33

# --- Vector index ---
# bruteforce: exact, no rebuild cost. Correct choice under ~100k chunks.
# hnsw:       approximate (needs `pip install faiss-cpu`). Only worth it past
#             ~200k chunks — it costs 17.7s to rebuild at 50k, after every ingest.
VECTOR_INDEX_BACKEND=bruteforce
VECTOR_INDEX_PATH=data/db/hnsw_index.bin
HNSW_M=16
HNSW_EF_CONSTRUCTION=200
HNSW_EF_SEARCH=64
ANN_ACL_OVERFETCH=10

# --- Caching ---
# Cache keys include the caller's ACL groups — see app/cache.py. Measured
# effect: 162ms -> 0.1ms on a repeat question.
QUERY_CACHE_ENABLED=true
QUERY_CACHE_SIZE=512
QUERY_CACHE_TTL_SECONDS=300

# --- Rate limiting ---
# In-process only. With multiple workers the effective limit is N x this value;
# enforce at the proxy instead. See DEPLOYMENT.md §4.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- Generation ---
# none  = extractive mode: returns real retrieved passages. No key, no cost,
#         cannot hallucinate. A legitimate production choice.
# mock  = deterministic fake used by the test suite. Never use in production.
# groq | gemini | openai = synthesized answers (see MANUAL_STEPS.md §2).
LLM_PROVIDER=none

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
