# Copy to .env and edit. Defaults are safe and free: no auth needed for this
# demo build (see README's "Known limitations"), local extraction, no keys.

DB_PATH=data/db/helpdesk.sqlite3

# --- Extraction ---
# none  = rule-based keyword extraction. No key, no cost, always available,
#         and legible (you can read exactly why it classified something a
#         certain way). Weaker than an LLM on genuinely ambiguous text.
# mock  = deterministic fake, test suite only.
# groq | gemini = real LLM extraction.
LLM_PROVIDER=none

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- KB deflection ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Below this cosine-similarity score, no self-service article is offered —
# a low-confidence "maybe this helps" wastes the user's time more than it
# saves. Untuned beyond this project's own 5-article demo KB; recalibrate
# once a client's real KB is loaded (see MANUAL_STEPS.md).
KB_DEFLECTION_THRESHOLD=0.55

# --- Alerting ---
# Leave blank to fall back to structured logging (still visible in any log
# aggregator) instead of a real page — fine for a demo, not for production.
SLACK_WEBHOOK_URL=
P1_ESCALATION_MINUTES=15

LOG_LEVEL=INFO
