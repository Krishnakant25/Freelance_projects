# Copy to .env and edit. Defaults are safe and free: no auth needed for this
# demo build (see README's "Known limitations"), local extraction, no keys.

DB_PATH=data/db/helpdesk.sqlite3

# --- Extraction ---
# none  = rule-based keyword extraction. No key, no cost, always available,
#         and legible (you can read exactly why it classified something a
#         certain way). Weaker than an LLM on genuinely ambiguous text.
# mock  = deterministic fake, test suite only.
# groq | gemini = real LLM extraction.
LLM_PROVIDER=none

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- KB deflection ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Below this cosine-similarity score, no self-service article is offered —
# a low-confidence "maybe this helps" wastes the user's time more than it
# saves. Untuned beyond this project's own 5-article demo KB; recalibrate
# once a client's real KB is loaded (see MANUAL_STEPS.md).
KB_DEFLECTION_THRESHOLD=0.55

# --- Alerting ---
# Leave blank to fall back to structured logging (still visible in any log
# aggregator) instead of a real page — fine for a demo, not for production.
SLACK_WEBHOOK_URL=
P1_ESCALATION_MINUTES=15

LOG_LEVEL=INFO

# ============================================================
# Production settings (added during the hardening pass —
# see PRODUCTION_NOTES.md for why each of these exists)
# ============================================================

# --- Request limits ---
# /report runs an embedding model over the description, so unbounded text is
# cheap to send and expensive to serve. These are the caps that prevent that.
MAX_DESCRIPTION_CHARS=4000
MAX_REQUESTER_CHARS=120

# --- Rate limiting ---
# In-process only: with N workers the effective limit is N x this value, and
# it resets on restart. Adequate against runaway clients; NOT a DoS control.
# Enforce at the proxy/gateway for that.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- Startup ---
# Load the embedding model at boot instead of on the first request. Without
# this the first real user waits ~30s (measured), which reads as a hung page.
WARMUP_ON_STARTUP=true

# --- Database ---
# How long a writer waits for a lock before failing. Without this SQLite
# raises "database is locked" immediately on contention.
DB_BUSY_TIMEOUT_SECONDS=10

# --- Alerting reliability ---
# A dropped page on a security incident is this system's most expensive
# single failure, so one attempt isn't enough. Still best-effort in-process,
# not a durable queue — see PRODUCTION_NOTES.md 3.3.
ALERT_MAX_ATTEMPTS=3
ALERT_TIMEOUT_SECONDS=8

# --- Logging ---
# true = JSON lines for a log aggregator. Every response carries X-Request-ID.
LOG_JSON=false

# --- Authentication (staff/admin endpoints only) ---
# Intake endpoints (/report etc.) are ANONYMOUS BY DESIGN — see app/auth.py.
# These keys gate ticket data and admin actions.
# Create keys with: python scripts/manage_keys.py create --name X --roles staff
# NEVER set AUTH_ENABLED=false outside local development.
AUTH_ENABLED=true
API_KEYS_PATH=keys.json

# --- Escalation scheduler ---
# Runs escalation sweeps + outbox flushes in-process, so the "unacknowledged
# P1s escalate" guarantee holds without external cron. Before this existed
# nothing called check_escalations() and the guarantee silently never fired.
#
# MULTI-WORKER: each worker runs its own scheduler. Run --workers 1, OR set
# SCHEDULER_ENABLED=false everywhere and have cron hit
# POST /admin/check-escalations instead.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# Minimum gap between escalation alerts for the SAME ticket. Without this,
# every scheduler tick re-pages an unacknowledged P1 — every 60s, forever,
# which trains people to mute the channel.
ESCALATION_COOLDOWN_MINUTES=30

# Total delivery attempts across all sweeps before an alert is marked 'failed'
# and stops retrying. Failed rows are KEPT (not deleted) and surfaced in
# /ready — they're the record that a page was owed and never delivered.
ALERT_MAX_TOTAL_ATTEMPTS=12
