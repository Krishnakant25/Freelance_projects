# Copy to .env and edit. Defaults run fully locally: no keys, no network.

WAREHOUSE_PATH=data/warehouse.sqlite3
APP_DB_PATH=data/app.sqlite3
SEMANTIC_MODEL_PATH=model/semantic_model.yaml

# --- Selector (question -> Selection) ---
# none  = rule-based matching over the semantic model's synonyms. No key, no
#         cost, and legible: you can read why a word mapped to a metric.
# mock  = deterministic fake, test suite only.
# groq | gemini = LLM selection. STILL CONSTRAINED — the model returns metric
#         and dimension NAMES from the defined vocabulary; anything it invents
#         is rejected by validate_selection() rather than becoming SQL.
#         NOTE: untested against a live provider. See PRODUCTION_GAPS.md 2.3.
LLM_PROVIDER=none

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Guardrails ---
# Enforced at the DATABASE layer, not by asking a model to behave.
MAX_RESULT_ROWS=1000
# Rows the planner may scan before the query is refused. Stands in for the
# bytes-scanned ceiling you'd set on BigQuery/Snowflake, where one accidental
# cross join costs real money.
MAX_SCAN_ROWS=5000000
QUERY_TIMEOUT_SECONDS=15

# --- Cache ---
# NOTE: the key covers SQL + params but NOT user identity. That becomes a leak
# the moment row-level security exists — see PRODUCTION_GAPS.md 2.9.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
# Hard entry cap with LRU eviction. Payloads hold full ROW SETS, so a TTL alone
# is not enough — without this the cache grew forever until restart.
CACHE_MAX_ENTRIES=200

# --- Defaults (always disclosed as assumptions, never applied silently) ---
DEFAULT_DATE_RANGE=last_30_days
DEFAULT_TIME_GRAIN=day

# --- Sample data (deterministic: same seed = same numbers = stable goldens) ---
SAMPLE_SEED=20260817
SAMPLE_DAYS=400
SAMPLE_ORDERS=6000

LOG_LEVEL=INFO
