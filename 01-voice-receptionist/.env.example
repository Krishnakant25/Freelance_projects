# Copy to .env and edit. Defaults run entirely locally — no keys, no telephony.

DB_PATH=data/db/receptionist.sqlite3
DB_BUSY_TIMEOUT_SECONDS=10

# --- Business identity / hours ---
# Hours drive the escalation ladder: inside them the agent transfers, outside
# them it takes a callback instead of ringing a phone nobody answers.
BUSINESS_NAME=Northside Dental
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=17
BUSINESS_DAYS=0,1,2,3,4
HUMAN_TRANSFER_NUMBER=
EMERGENCY_ONCALL_NUMBER=

# --- Legal (architecture doc §6.7) ---
# Consent cannot be retrofitted onto recordings already taken, which is why
# these are enforced in the opening turn rather than left to wording.
# Confirm specifics with the client's counsel per jurisdiction.
DISCLOSE_AI=true
DISCLOSE_RECORDING=true
RECORDING_ENABLED=false
TRANSCRIPT_RETENTION_DAYS=90

# --- Booking ---
APPOINTMENT_MINUTES=30
# How long a tentative hold survives. Long enough for a caller to finish giving
# details; short enough that an abandoned call doesn't block a slot all day.
SLOT_HOLD_SECONDS=180
BOOKING_LOOKAHEAD_DAYS=21
# Whether the agent may PROMISE an SMS confirmation. Leave false until a real
# SMS provider is wired — the gate exists so the promise and the capability
# can't drift apart.
SMS_CONFIRMATIONS_ENABLED=false

# --- Conversation safety (doc §6.6) ---
# After this many consecutive misunderstood turns, stop trying and capture a
# callback. A graceful capture beats a clever agent looping.
MAX_CONSECUTIVE_CONFUSIONS=2
MAX_TURNS=40

# --- FAQ ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Below this score the agent says it doesn't know and offers a callback rather
# than reading out a plausible-but-wrong answer the caller can't check.
FAQ_MATCH_THRESHOLD=0.50
WARMUP_ON_STARTUP=true

# --- Latency budget (doc §6.1) ---
# A measurement target, not a limiter. NOTE: the agent only controls its own
# decision time (~18ms). A real call adds endpointing, STT, TTS and network,
# which dominate — that's why the doc calls <800ms an architecture decision.
TARGET_TURN_LATENCY_MS=800

LOG_LEVEL=INFO
LOG_JSON=false
